+  } else if (preset.mixed) {
+    const per = Math.max(1, Math.ceil(n / 5));
+    for (let d = 1; d <= 5; d++) plans.push({ ...base, qtypes, difficulty: d, n: per, pool: per * 3, stage: "primary" });
+    plans.push({ ...base, qtypes, n, pool: n * 3, stage: "fill" });
