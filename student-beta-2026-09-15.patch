+    if ((cnt[k] || 0) >= perTpl) continue;
+    cnt[k] = (cnt[k] || 0) + 1;
+    out.push(it);
+    if (out.length >= n) break;
+  }
+  if (out.length < n) {
+    const have = new Set(out);
