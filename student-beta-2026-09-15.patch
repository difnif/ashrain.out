+          {wrong.length > 0 && uid && <button className="sv-btn pri" disabled={saved} onClick={saveWrong}>{saved ? "📕 오답노트에 저장됨" : `📕 틀린 ${wrong.length}문제 오답노트에 저장`}</button>}
