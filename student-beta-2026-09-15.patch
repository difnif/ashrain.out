+    const results = judgeAll(items, answers, elapsed);
+    const runId = newRunId(preset.code, startedAt);
+    const ctx = {
+      unitId: scope.unitId || (scope.kind === "unit" ? scope.id : null),
+      conceptId: scope.kind === "concept" ? scope.id : null,
