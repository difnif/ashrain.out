+    return row;
+  });
+  return {
+    W: SHEET_W, H: SHEET_H,
+    markers: markerRects(),
+    orient: { ...ORIENT },
+    rows, cols,
+    header: { codeY: 150, titleY: 208, subY: 238, instrY: 270, nameY: 304, dividerX: cols === 2 ? 497 : null },
+    meta: { code: String(code || ""), n },
