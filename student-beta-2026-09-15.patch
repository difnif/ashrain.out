+    if (!itemId) return;
+    let alive = true;
+    fetchItem(itemId).then((it) => { if (!alive) return; if (!it) setErr("문항을 찾을 수 없어요. 공개되지 않은 문항일 수도 있어요."); else setItem(it); })
+      .catch(() => alive && setErr("문항을 불러오지 못했어요. 잠시 뒤 다시 시도해 주세요."));
