+// ── 날짜 (하루 상한은 한국 시간 기준) ────────────────────────────────────────
+
+const KST = 9 * 3600000;
+/** 한국 시간으로 "오늘" 0시 → ISO 문자열 */
+export function kstDayStart(now = Date.now()) {
+  const t = typeof now === "number" ? now : new Date(now).getTime();
+  const day = Math.floor((t + KST) / 86400000);
+  return new Date(day * 86400000 - KST).toISOString();
+}
