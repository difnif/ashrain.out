+        <radialGradient id="wl-g-water" cx="46%" cy="42%"><stop offset="0%" stopColor="#1D7A8C" /><stop offset="70%" stopColor="#0F4A5C" /><stop offset="100%" stopColor="#0B3644" /></radialGradient>
