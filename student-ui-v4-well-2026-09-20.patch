+              <span className="nm">{t.nm}</span>
+              <span className="ds">{t.ds}</span>
+              {one && <span className="tl-go">바로 시작 →</span>}
+            </button>
+          ))}
+        </div>
+        {!one && <p className="tl-note">공부(개념·연습문제·시험)는 아래 「공부하기」 탭에, 여기는 공부를 돕는 도구들이에요.</p>}
+      </div>
+    </div>
+  );
+}
