+  cursor: pointer; box-shadow: 0 8px 20px rgba(0,0,0,.22); }
+.bd-dark .bd-fab { color: #08302B; }
+.bd-card { background: var(--card); border: 1px solid var(--bd); border-radius: 14px; padding: 16px; margin-bottom: 10px; }
