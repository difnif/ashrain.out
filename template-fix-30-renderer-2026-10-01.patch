+def _axis_tick(hi) -> Fraction:
+    """앱 렌더러(src/lib/figsvg.js 의 axes)가 0 ~ hi 축에 긋는 눈금 간격 — raw = hi/8 이상인 첫 [1, 2, 2.5, 5, 10] × 10ⁿ (10ⁿ ≤ raw)."""
+    raw = Fraction(hi, 8)
+    p = Fraction(1)
+    while p * 10 <= raw:
+        p *= 10
+    while p > raw:
+        p /= 10
+    return next((k * p for k in (1, 2, Fraction(5, 2), 5, 10) if k * p >= raw), 10 * p)
