{"id":"w-h2-37a","pp":8,"note":"부정적분은 미분의 거꾸로예요. 답을 미분해서 원래 식이 나오는지 늘 확인하게 해 주세요. 정적분은 C가 지워져서 넣지 않아도 돼요.","tips":{"1":"∫x^{n}dx = {1/n + 1}x^{n + 1} + C — 차수를 하나 올리고 그 수로 나눠요","2":"∫x^{n}dx = {1/n + 1}x^{n + 1} + C — 차수를 하나 올리고 그 수로 나눠요","3":"∫x^{n}dx = {1/n + 1}x^{n + 1} + C — 차수를 하나 올리고 그 수로 나눠요","4":"∫x^{n}dx = {1/n + 1}x^{n + 1} + C — 차수를 하나 올리고 그 수로 나눠요","5":"∫x^{n}dx = {1/n + 1}x^{n + 1} + C — 차수를 하나 올리고 그 수로 나눠요"},"items":[{"no":1,"st":1,"q":"부정적분 ∫(−2x + 6)dx를 구하세요.","ans":"−x^{2} + 6x + C","plan":"∫x^{n}dx = {1/n + 1}x^{n + 1} + C","lines":[{"s":"∫(−2x + 6)dx = −x^{2} + 6x + C","memo":"항마다 차수 + 1, 그 수로 나누기"}],"ap":"−x^2 + 6x + C","omr":"ex"},{"no":2,"st":1,"q":"부정적분 ∫(x)(x + 1)dx를 구하세요.","ans":"{1/3}x^{3} + {1/2}x^{2} + C","plan":"∫x^{n}dx = {1/n + 1}x^{n + 1} + C","lines":[{"s":"(x)(x + 1) = x^{2} + x","memo":"먼저 전개"},{"s":"∫(x^{2} + x)dx = {1/3}x^{3} + {1/2}x^{2} + C","memo":"항마다 차수 + 1, 그 수로 나누기"}],"ap":"1/3x^3 + 1/2x^2 + C","omr":"ex"},{"no":3,"st":1,"q":"부정적분 ∫(−4x^{3} − 12x^{2} + 8x + 2)dx를 구하세요.","ans":"−x^{4} − 4x^{3} + 4x^{2} + 2x + C","plan":"∫x^{n}dx = {1/n + 1}x^{n + 1} + C","lines":[{"s":"∫(−4x^{3} − 12x^{2} + 8x + 2)dx = −x^{4} − 4x^{3} + 4x^{2} + 2x + C","memo":"항마다 차수 + 1, 그 수로 나누기"}],"ap":"−x^4 − 4x^3 + 4x^2 + 2x + C","omr":"ex"},{"no":4,"st":1,"q":"부정적분 ∫(9x^{2} − 8x − 4)dx를 구하세요.","ans":"3x^{3} − 4x^{2} − 4x + C","plan":"∫x^{n}dx = {1/n + 1}x^{n + 1} + C","lines":[{"s":"∫(9x^{2} − 8x − 4)dx = 3x^{3} − 4x^{2} − 4x + C","memo":"항마다 차수 + 1, 그 수로 나누기"}],"ap":"3x^3 − 4x^2 − 4x + C","omr":"ex"},{"no":5,"st":2,"q":"부정적분 ∫(x)(x − 1)dx를 구하세요.","ans":"{1/3}x^{3} − {1/2}x^{2} + C","plan":"∫x^{n}dx = {1/n + 1}x^{n + 1} + C","lines":[{"s":"(x)(x − 1) = x^{2} − x","memo":"먼저 전개"},{"s":"∫(x^{2} − x)dx = {1/3}x^{3} − {1/2}x^{2} + C","memo":"항마다 차수 + 1, 그 수로 나누기"}],"ap":"1/3x^3 − 1/2x^2 + C","omr":"ex"},{"no":6,"st":2,"q":"부정적분 ∫(3x^{2} − 8x + 5)dx를 구하세요.","ans":"x^{3} − 4x^{2} + 5x + C","plan":"∫x^{n}dx = {1/n + 1}x^{n + 1} + C","lines":[{"s":"∫(3x^{2} − 8x + 5)dx = x^{3} − 4x^{2} + 5x + C","memo":"항마다 차수 + 1, 그 수로 나누기"}],"ap":"x^3 − 4x^2 + 5x + C","omr":"ex"},{"no":7,"st":2,"q":"부정적분 ∫(3x^{2} + 2x − 5)dx를 구하세요.","ans":"x^{3} + x^{2} − 5x + C","plan":"∫x^{n}dx = {1/n + 1}x^{n + 1} + C","lines":[{"s":"∫(3x^{2} + 2x − 5)dx = x^{3} + x^{2} − 5x + C","memo":"항마다 차수 + 1, 그 수로 나누기"}],"ap":"x^3 + x^2 − 5x + C","omr":"ex"},{"no":8,"st":2,"q":"부정적분 ∫(x + 4)(x + 2)dx를 구하세요.","ans":"{1/3}x^{3} + 3x^{2} + 8x + C","plan":"∫x^{n}dx = {1/n + 1}x^{n + 1} + C","lines":[{"s":"(x + 4)(x + 2) = x^{2} + 6x + 8","memo":"먼저 전개"},{"s":"∫(x^{2} + 6x + 8)dx = {1/3}x^{3} + 3x^{2} + 8x + C","memo":"항마다 차수 + 1, 그 수로 나누기"}],"ap":"1/3x^3 + 3x^2 + 8x + C","omr":"ex"},{"no":9,"st":3,"q":"부정적분 ∫(6x^{2} + 2x − 4)dx를 구하세요.","ans":"2x^{3} + x^{2} − 4x + C","plan":"∫x^{n}dx = {1/n + 1}x^{n + 1} + C","lines":[{"s":"∫(6x^{2} + 2x − 4)dx = 2x^{3} + x^{2} − 4x + C","memo":"항마다 차수 + 1, 그 수로 나누기"}],"ap":"2x^3 + x^2 − 4x + C","omr":"ex"},{"no":10,"st":3,"q":"부정적분 ∫(3x^{2} + 4x)dx를 구하세요.","ans":"x^{3} + 2x^{2} + C","plan":"∫x^{n}dx = {1/n + 1}x^{n + 1} + C","lines":[{"s":"∫(3x^{2} + 4x)dx = x^{3} + 2x^{2} + C","memo":"항마다 차수 + 1, 그 수로 나누기"}],"ap":"x^3 + 2x^2 + C","omr":"ex"},{"no":11,"st":3,"q":"부정적분 ∫(x + 2)(x + 2)dx를 구하세요.","ans":"{1/3}x^{3} + 2x^{2} + 4x + C","plan":"∫x^{n}dx = {1/n + 1}x^{n + 1} + C","lines":[{"s":"(x + 2)(x + 2) = x^{2} + 4x + 4","memo":"먼저 전개"},{"s":"∫(x^{2} + 4x + 4)dx = {1/3}x^{3} + 2x^{2} + 4x + C","memo":"항마다 차수 + 1, 그 수로 나누기"}],"ap":"1/3x^3 + 2x^2 + 4x + C","omr":"ex"},{"no":12,"st":3,"q":"부정적분 ∫(9x^{2} − 3)dx를 구하세요.","ans":"3x^{3} − 3x + C","plan":"∫x^{n}dx = {1/n + 1}x^{n + 1} + C","lines":[{"s":"∫(9x^{2} − 3)dx = 3x^{3} − 3x + C","memo":"항마다 차수 + 1, 그 수로 나누기"}],"ap":"3x^3 − 3x + C","omr":"ex"},{"no":13,"st":4,"q":"부정적분 ∫(6x^{2} − 3)dx를 구하세요.","ans":"2x^{3} − 3x + C","plan":"∫x^{n}dx = {1/n + 1}x^{n + 1} + C","lines":[{"s":"∫(6x^{2} − 3)dx = 2x^{3} − 3x + C","memo":"항마다 차수 + 1, 그 수로 나누기"}],"ap":"2x^3 − 3x + C","omr":"ex"},{"no":1