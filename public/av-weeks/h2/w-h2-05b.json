_{3} {405/5}","memo":"차 → 몫"},{"s":"log_{3} 81 = 4"}],"ap":"4","omr":"num"},{"no":15,"st":4,"q":"log_{2} 3 × log_{3} 16의 값을 구하세요.","ans":"4","plan":"곱 → 합 · 몫 → 차 · 거듭제곱 → 앞으로 · 밑변환","lines":[{"s":"log_{2} 3 × log_{3} 16 = {log 3/log 2} × {log 16/log 3}","memo":"밑변환 — 밑을 10으로"},{"s":"= {log 16/log 2} = {4 log 2/log 2} = 4","memo":"log 3끼리 약분"}],"ap":"4","omr":"num"},{"no":16,"st":4,"q":"2 log_{5} 10 − log_{5} 4의 값을 구하세요.","ans":"2","plan":"곱 → 합 · 몫 → 차 · 거듭제곱 → 앞으로 · 밑변환","lines":[{"s":"2 log_{5} 10 = log_{5} 10^{2}","memo":"앞의 수는 지수로"},{"s":"log_{5} 10^{2} − log_{5} 4 = log_{5} {100/4}"},{"s":"log_{5} 25 = 2"}],"ap":"2","omr":"num"},{"no":17,"st":5,"q":"log_{12} 4 + log_{12} 36의 값을 구하세요.","ans":"2","plan":"곱 → 합 · 몫 → 차 · 거듭제곱 → 앞으로 · 밑변환","lines":[{"s":"log_{12} 4 + log_{12} 36 = log_{12} (4 × 36)","memo":"합 → 곱"},{"s":"log_{12} 144 = log_{12} 12^{2} = 2"}],"ap":"2","omr":"num"},{"no":18,"st":5,"q":"log_{3} 63 − log_{3} 7의 값을 구하세요.","ans":"2","plan":"곱 → 합 · 몫 → 차 · 거듭제곱 → 앞으로 · 밑변환","lines":[{"s":"log_{3} 63 − log_{3} 7 = log_{3} {63/7}","memo":"차 → 몫"},{"s":"log_{3} 9 = 2"}],"ap":"2","omr":"num"},{"no":19,"st":5,"q":"2 log_{3} 18 − log_{3} 4의 값을 구하세요.","ans":"4","plan":"곱 → 합 · 몫 → 차 · 거듭제곱 → 앞으로 · 밑변환","lines":[{"s":"2 log_{3} 18 = log_{3} 18^{2}","memo":"앞의 수는 지수로"},{"s":"log_{3} 18^{2} − log_{3} 4 = log_{3} {324/4}"},{"s":"log_{3} 81 = 4"}],"ap":"4","omr":"num"},{"no":20,"st":5,"q":"log_{10} 4 + log_{10} 25의 값을 구하세요.","ans":"2","plan":"곱 → 합 · 몫 → 차 · 거듭제곱 → 앞으로 · 밑변환","lines":[{"s":"log_{10} 4 + log_{10} 25 = log_{10} (4 × 25)","memo":"합 → 곱"},{"s":"log_{10} 100 = log_{10} 10^{2} = 2"}],"ap":"2","omr":"num"}]}