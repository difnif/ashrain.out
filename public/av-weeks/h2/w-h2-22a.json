 {1/k + 2})","memo":"부분분수"},{"s":"앞의 1, {1/2}과 뒤의 −{1/22}, −{1/23}만 남아요","memo":"두 칸 건너 지워져요"},{"s":"{1/2}(1 + {1/2} − {1/22} − {1/23}) = {357/506}"}],"ap":"357/506","omr":"num"},{"no":6,"st":2,"q":"Σ_{k=1}^{6}{1/k(k + 1)}의 값을 구하세요.","ans":"{6/7}","plan":"부분분수로 나누면 이웃끼리 지워져요","lines":[{"s":"{1/k(k + 1)} = {1/k} − {1/k + 1}","memo":"부분분수"},{"s":"(1 − {1/2}) + ({1/2} − {1/3}) + … + ({1/6} − {1/7})","memo":"이웃끼리 지워져요"},{"s":"1 − {1/7} = {6/7}"}],"ap":"6/7","omr":"num"},{"no":7,"st":2,"q":"Σ_{k=1}^{19}{1/(2k − 1)(2k + 1)}의 값을 구하세요.","ans":"{19/39}","plan":"부분분수로 나누면 이웃끼리 지워져요","lines":[{"s":"{1/(2k − 1)(2k + 1)} = {1/2}({1/2k − 1} − {1/2k + 1})","memo":"부분분수"},{"s":"{1/2}{(1 − {1/3}) + ({1/3} − {1/5}) + … + ({1/37} − {1/39})}","memo":"이웃끼리 지워져요"},{"s":"{1/2}(1 − {1/39}) = {19/39}"}],"ap":"19/39","omr":"num"},{"no":8,"st":2,"q":"Σ_{k=1}^{25}{1/k(k + 1)}의 값을 구하세요.","ans":"{25/26}","plan":"부분분수로 나누면 이웃끼리 지워져요","lines":[{"s":"{1/k(k + 1)} = {1/k} − {1/k + 1}","memo":"부분분수"},{"s":"(1 − {1/2}) + ({1/2} − {1/3}) + … + ({1/25} − {1/26})","memo":"이웃끼리 지워져요"},{"s":"1 − {1/26} = {25/26}"}],"ap":"25/26","omr":"num"},{"no":9,"st":3,"q":"log_{27} 9의 값을 구하세요.","ans":"{2/3}","plan":"log_{a} N = x ⇔ a^{x} = N","lines":[{"s":"27^{x} = 9 에서 3^{3x} = 3^{2}","memo":"값을 x로 두고 정의대로"},{"s":"3x = 2 → x = {2/3}"},{"s":"log_{27} 9 = {2/3}"}],"ap":"2/3","omr":"num"},{"no":10,"st":3,"q":"log_{2} {1/32}의 값을 구하세요.","ans":"−5","plan":"log_{a} N = x ⇔ a^{x} = N","lines":[{"s":"{1/32} = 2^{−5}","memo":"역수는 지수가 음수"},{"s":"log_{2} {1/32} = −5"}],"ap":"−5","omr":"num"},{"no":11,"st":3,"q":"log_{3} 9의 값을 구하세요.","ans":"2","plan":"log_{a} N = x ⇔ a^{x} = N","lines":[{"s":"9 = 3^{2}","memo":"3을 몇 제곱하면 9?"},{"s":"log_{3} 9 = 2"}],"ap":"2","omr":"num"},{"no":12,"st":3,"q":"log_{3} {1/81}의 값을 구하세요.","ans":"−4","plan":"log_{a} N = x ⇔ a^{x} = N","lines":[{"s":"{1/81} = 3^{−4}","memo":"역수는 지수가 음수"},{"s":"log_{3} {1/81} = −4"}],"ap":"−4","omr":"num"},{"no":13,"st":4,"q":"방정식 log_{3}(2x − 3) = 3을 푸세요.","ans":"x = 15","plan":"log_{a}f(x) = b ⇔ f(x) = a^{b}, 진수 > 0","lines":[{"s":"2x − 3 = 3^{3} = 27","memo":"로그의 정의"},{"s":"x = 15"},{"s":"진수 2x − 3 = 27 > 0","memo":"진수 조건 확인"}],"ap":"x = 15","omr":"ex"},{"no":14,"st":4,"q":"0 ≤ x ≤ 1에서 함수 y = 2^{x} + 5의 최댓값과 최솟값의 합을 구하세요.","ans":"13","plan":"증가함수는 오른쪽 끝, 감소함수는 왼쪽 끝에서 최대","lines":[{"s":"밑 2 > 1 → 증가함수","memo":"구간의 양 끝"},{"s":"최댓값 2^{1} + 5 = 7, 최솟값 2^{0} + 5 = 6","memo":"x = 1에서 최대"},{"s":"7 + 6 = 13"}],"ap":"13","omr":"num"},{"no":15,"st":4,"q":"방정식 log_{2}(x + 4) = 3을 푸세요.","ans":"x = 4","plan":"log_{a}f(x) = b ⇔ f(x) = a^{b}, 진수 > 0","lines":[{"s":"x + 4 = 2^{3} = 8","memo":"로그의 정의"},{"s":"x = 4"},{"s":"진수 x + 4 = 8 > 0","memo":"진수 조건 확인"}],"ap":"x = 4","omr":"ex"},{"no":16,"st":4,"q":"1 ≤ x ≤ 4에서 함수 y = 3^{x}의 최댓값과 최솟값의 합을 구하세요.","ans":"84","plan":"증가함수는 오른쪽 끝, 감소함수는 왼쪽 끝에서 최대","lines":[{"s":"밑 3 > 1 → 증가함수","memo":"구간의 양 끝"},{"s":"최댓값 3^{4} = 81, 최솟값 3^{1} = 3","memo":"x = 4에서 최대"},{"s":"81 + 3 = 84"}],"ap":"84","omr":"num"},{"no":17,"st":5,"q":"θ가 제4사분면의 각이고 sin θ = −{8/17}일 때, cos θ의 값을 구하세요.","ans":"{15/17}","plan":"제곱 관계로 크기, 사분면으로 부호","lines":[{"s":"cos^{2}θ = 1 − (−{8/17})^{2} = {225/289}","memo":"sin^{2}θ + cos^{2}θ = 1"},{"s":"제4사분면에서 cos θ > 0 → cos θ = {15/17}","memo":"사분면으로 부호"}],"ap":"15/17","omr":"num"},{"no":18,"st":5,"q":"θ가 제3사분면의 각이고 cos θ = −{8/17}일 때, sin θ의 값을 구하세요.","ans":"−{15/17}","plan":"제곱 관계로 크기, 사분면으로 부호","lines":[{"s":"sin^{2}θ = 1 − (−{8/17})^{2} = {225/289}","memo":"sin^{2}θ + cos^{2}θ = 1"},{"s":"제3사분면에서 sin θ < 0 → sin θ = −{15/17}","memo":"사분면으로 부호"}],"ap":"−15/17","omr":"num"},{"no":19,"st":5,"q":"θ가 제3사분면의 각이고 sin θ = −{8/17}일 때, cos θ의 값을 구하세요.","ans":"−{15/17}","plan":"제곱 관계로 크기, 사분면으로 부호","lines":[{"s":"cos^{2}θ = 1 − (−{8/17})^{2} = {225/289}","memo":"sin^{2}θ + cos^{2}θ = 1"},{"s":"제3사분면에서 cos θ < 0 → cos θ = −{15/17}","memo":"사분면으로 부호"}],"ap":"−15/17","omr":"num"},{"no":20,"st":5,"q":"θ가 제2사분면의 각이고 sin θ = {4/5}일 때, cos θ의 값을 구하세요.","ans":"−{3/5}","plan":"제곱 관계로 크기, 사분면으로 부호","lines":[