 + 1) × (1 + 1) × (1 + 1) = 12","memo":"각 소인수를 0번부터 지수 번까지 고르는 방법"},{"s":"12개"}],"ap":"12","omr":"num"},{"no":17,"st":5,"q":"225의 약수는 모두 몇 개인가요?","ans":"9개","plan":"약수의 개수 = (지수 + 1)끼리의 곱","lines":[{"s":"225 = 3^{2} × 5^{2}","memo":"소인수분해"},{"s":"(2 + 1) × (2 + 1) = 9","memo":"지수에 1씩 더해 곱해요"},{"s":"9개"}],"ap":"9","omr":"num"},{"no":18,"st":5,"q":"2 × 7^{2} × 11의 약수는 모두 몇 개인가요?","ans":"12개","plan":"약수의 개수 = (지수 + 1)끼리의 곱","lines":[{"s":"(1 + 1) × (2 + 1) × (1 + 1) = 12","memo":"각 소인수를 0번부터 지수 번까지 고르는 방법"},{"s":"12개"}],"ap":"12","omr":"num"},{"no":19,"st":5,"q":"200의 약수는 모두 몇 개인가요?","ans":"12개","plan":"약수의 개수 = (지수 + 1)끼리의 곱","lines":[{"s":"200 = 2^{3} × 5^{2}","memo":"소인수분해"},{"s":"(3 + 1) × (2 + 1) = 12","memo":"지수에 1씩 더해 곱해요"},{"s":"12개"}],"ap":"12","omr":"num"},{"no":20,"st":5,"q":"5^{2} × 7의 약수는 모두 몇 개인가요?","ans":"6개","plan":"약수의 개수 = (지수 + 1)끼리의 곱","lines":[{"s":"(2 + 1) × (1 + 1) = 6","memo":"각 소인수를 0번부터 지수 번까지 고르는 방법"},{"s":"6개"}],"ap":"6","omr":"num"}]}