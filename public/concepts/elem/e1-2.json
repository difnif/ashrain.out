    "chips": [
     "△△□ | △△□",
     "19, 20, 21 → 1씩 커짐"
    ],
    "chipLabel": "되풀이 묶음",
    "style": {
     "size": "md",
     "tone": "teal",
     "width": "full"
    }
   },
   {
    "id": "b4",
    "icon": {
     "kind": "emoji",
     "value": "📢"
    },
    "type": "text",
