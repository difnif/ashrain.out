--- /dev/null
+++ b/whygen/sql.py
@@ -0,0 +1,189 @@
+# 개념 카드 「💡 왜 그럴까?」 단락 → DB(concepts.blocks) SQL (whygen/sql.py)
+#   python3 whygen/sql.py check-data              자료(w_<학기>.py)만 검사 — 줄 수 · 굵게/칠하기 짝 · ASCII 빼기 · 중1 · 중2 의 √ · 길이
+#   python3 whygen/sql.py apply <학기|all>         넣기 — 개념마다 「꼭 조심할 것」(warning) 단락 바로 앞에(없으면 「바로 확인」 앞, 그것도 없으면 맨 끝)
+#                                                이미 있으면 줄만 새로(같은 단락 id 그대로) · 몇 번 돌려도 같다 · 넣은 개념마다 빼기 검산(md5)
+#   python3 whygen/sql.py rollback <학기|all>      빼기 — 이 생성기가 넣은 단락(src "why")만 지운다
+#   python3 whygen/sql.py check <학기|all>         확인 — 자료의 개념마다 단락이 꼭 하나 · 자리(warning 앞) · 줄이 자료와 같은지(맞으면 total 한 줄만)
+# 단락 = { id: b<지금 가장 큰 번호 + 1>, icon 💡, type text, label 「왜 그럴까?」, src "why", lines, style { size md · tone slate · width full }, figure null }
+#   개념에 「왜 그럴까?」 단락이 처음부터 있으면(src 없음) 넣지 않고 건너뛴다(겹치지 않게).
+#   — h1-1-14(「왜 더하고, 왜 곱할까?」) · m2-2-12(b2 · b3 안의 「왜 더할까? · 왜 곱할까?」)는 2026-11-25 먼저 따로 넣었다 — 이 생성기는 건드리지 않는다.
+# 글은 개념 본문(Rich — **굵게** · ==칠하기== · [[tone:글]])과 같은 문법. 수식은 유니코드(x² · −3 · 2/3), 중1 · 중2 는 √ 를 쓰지 않는다.
+# 현황(2026-11-26): 중1 ~ 고3 개념 259개 중 256개에 넣었다(빠진 셋 = h1-1-14 · m2-2-12 따로 넣음, m3-1-19 원래 단락 있음).
+#   자료 파일은 중1-1(w_m1_1.py)만 저장소에 있고, 나머지 학기 글은 DB(concepts.blocks 의 src "why" 단락)에만 있다 —
+#   고칠 때는 관리자 개념 편집(AdminConcepts)에서 그 단락을 고치거나, apply 와 같은 DO 블록을 MCP 로 돌린다(줄만 새로 바뀐다).
+#   check <학기|all> 은 자료 없이도 모든 개념의 자리 · 꼴 · 글 규칙을 본다.
+import importlib, json, os, re, sys
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, HERE)
+UNITS = ["m1-1", "m1-2", "m2-1", "m2-2", "m3-1", "m3-2", "h1-1", "h1-2", "h2-1", "h2-2", "h3-1", "h3-2", "h3-3"]
+LABEL = "왜 그럴까?"
+DONE_ELSEWHERE = {"h1-1-14", "m2-2-12"}
+BLOCK = {"icon": {"kind": "emoji", "value": "💡"}, "type": "text", "label": LABEL, "src": "why",
+         "style": {"size": "md", "tone": "slate", "width": "full"}, "figure": None}
+# 이 생성기가 넣은 단락의 표 — src: "why"(화면은 모른 척한다). 같은 이름(「왜 그럴까?」)의 단락을 처음부터 가진 개념(m3-1-19 b3)이 있어
+#   고르기 · 빼기는 반드시 이 표로 한다(이름으로 고르면 원래 단락까지 건드린다 — 2026-11-25 m3-1-19 를 백업에서 되살렸다).
+MINE = "z.b->>'src' = 'why'"
+
+
+def load(u):
+    try:
+        mod = importlib.import_module("w_" + u.replace("-", "_"))
+    except ModuleNotFoundError:
+        return {}
+    return mod.WHY
+
+
+def problems(u, why):
+    out = []
+    for cid, lines in why.items():
+        tag = f"{cid}"
+        if not re.fullmatch(rf"{u}-\d{{2}}", cid):
+            out.append(f"{tag}: 학기 {u} 의 개념 id 가 아님")
+        if cid in DONE_ELSEWHERE:
+            out.append(f"{tag}: 이미 따로 넣은 개념")
+        if not (2 <= len(lines) <= 4):
+            out.append(f"{tag}: 줄 {len(lines)}개(2 ~ 4)")
+        if not lines or not lines[0].startswith("**왜"):
+            out.append(f"{tag}: 첫 줄은 「**왜 …?**」로 시작")
+        for i, s in enumerate(lines):
+            t = f"{tag} 줄{i + 1}"
+            if not isinstance(s, str) or not s.strip():
+                out.append(f"{t}: 빈 줄"); continue
+            if s.count("**") % 2: out.append(f"{t}: ** 짝이 안 맞음")
+            if s.count("==") % 2: out.append(f"{t}: == 짝이 안 맞음")
+            if re.search(r"(^|[\s(=,])-(\d|[a-zA-Z])", s) or " - " in s: out.append(f"{t}: ASCII 빼기(−)")
+            if re.search(r"\d\s*\*\s*\d", s.replace("**", "")): out.append(f"{t}: * 곱하기(×)")
+            if u[:2] in ("m1", "m2") and "√" in s: out.append(f"{t}: 중1 · 중2 에 √")
+            if len(s) > 260: out.append(f"{t}: 너무 김({len(s)}자)")
+            if "[[" in s and not re.search(r"\[\[(teal|amber|coral|slate|blue|green|violet|rose):[^\]]+\]\]", s):
+                out.append(f"{t}: [[ ]] 는 [[tone:글]] 만")
+    return out
+
+
+def q(s):
+    return "'" + s.replace("'", "''") + "'"
+
+
+def lit(lines):
+    return "array[" + ", ".join(q(x) for x in lines) + "]"
+
+
+HEAD = """do $$
+declare r record; oi int; pos int; nid text; blk jsonb; ln jsonb; m0 text; m1 text; added int := 0; renewed int := 0;
+begin
+for r in select * from (values
+"""
+
+
+def tail():
+    base = json.dumps(BLOCK, ensure_ascii=False)
+    return f""") v(cid, lines) loop
+  if not exists (select 1 from concepts where id = r.cid) then raise exception '개념 없음: %', r.cid; end if;
+  if r.cid in ('h1-1-14', 'm2-2-12') then raise exception '이미 따로 넣은 개념: %', r.cid; end if;
+  ln := to_jsonb(r.lines);
+  oi := null;
+  select z.ord - 1 into oi from concepts c, jsonb_array_elements(c.blocks) with ordinality z(b, ord) where c.id = r.cid and {MINE};
+  if oi is null and exists (select 1 from concepts c, jsonb_array_elements(c.blocks) z(b) where c.id = r.cid and z.b->>'label' = {q(LABEL)}) then
+    raise notice '% — 원래 「{LABEL}」 단락이 있어 건너뜀', r.cid; continue;
+  end if;
+  if oi is not null then
+    update concepts set blocks = jsonb_set(blocks, array[oi::text, 'lines'], ln), updated_at = now() where id = r.cid and blocks->oi->'lines' is distinct from ln;
+    if found then renewed := renewed + 1; end if;
+    continue;
+  end if;
+  select coalesce(
+    (select min(z.ord) - 1 from concepts c, jsonb_array_elements(c.blocks) with ordinality z(b, ord) where c.id = r.cid and z.b->>'type' = 'warning'),
+    (select min(z.ord) - 1 from concepts c, jsonb_array_elements(c.blocks) with ordinality z(b, ord) where c.id = r.cid and z.b->>'type' = 'check'),
+    (select jsonb_array_length(blocks) from concepts where id = r.cid)) into pos;
+  select 'b' || (coalesce(max((substring(z.b->>'id' from '^b(\\d+)$'))::int), 0) + 1) into nid from concepts c, jsonb_array_elements(c.blocks) z(b) where c.id = r.cid;
+  blk := jsonb_build_object('id', nid, 'lines', ln) || {q(base)}::jsonb;
+  select md5(blocks::text) into m0 from concepts where id = r.cid;
+  update concepts set blocks = (select jsonb_agg(e order by o) from (select z.b as e, z.ord::numeric as o from jsonb_array_elements(blocks) with ordinality z(b, ord)
+    union all select blk, pos + 0.5) s), updated_at = now() where id = r.cid;
+  select md5(({back_expr()})::text) into m1 from concepts c where c.id = r.cid;
+  if m1 is distinct from m0 then raise exception '빼기 검산 어긋남: %', r.cid; end if;
+  added := added + 1;
+end loop;
+raise notice '「{LABEL}」 — 넣음 %, 줄 새로 %', added, renewed;
+end $$;
+"""
+
+
+def apply_sql(u, why):
+    rows = ",\n".join(f"({q(cid)}, {lit(lines)})" for cid, lines in sorted(why.items()))
+    return f"-- 「💡 {LABEL}」 단락 넣기 — {u} {len(why)}개념 (whygen/sql.py apply)\n" + HEAD + rows + "\n" + tail()
+
+
+def back_expr():
+    return (f"select coalesce(jsonb_agg(z.b order by z.ord), '[]'::jsonb) from jsonb_array_elements(c.blocks) with ordinality z(b, ord) "
+            f"where not coalesce({MINE}, false)")
+
+
+def scope(arg):
+    return UNITS if arg in (None, "all") else [arg]
+
+
+def rollback_sql(units):
+    pat = " or ".join(f"c.unit_id = {q(u)}" for u in units)
+    return f"""-- 「💡 {LABEL}」 단락 빼기 — {', '.join(units)} (whygen/sql.py rollback)
+update concepts c set blocks = ({back_expr()}), updated_at = now()
+where ({pat}) and exists (select 1 from jsonb_array_elements(c.blocks) z(b) where {MINE});
+"""
+
+
+def check_sql(units, data):
+    pat = ", ".join(q(u) for u in units)
+    have = [(cid, lines) for u in units for cid, lines in sorted(data[u].items())]
+    vals = ",\n    ".join(f"({q(cid)}, {q(json.dumps(lines, ensure_ascii=False))}::jsonb)" for cid, lines in have) or "(null, null)"
+    return f"""-- 「💡 {LABEL}」 단락 확인 (whygen/sql.py check) — 문제가 있는 것만 나온다(total 한 줄만 = 모두 맞음)
+--   모든 개념(h1-1-14 · m2-2-12 빼고)에 꼭 하나 · warning(없으면 check) 바로 앞 · text 단락 b<n> · 줄 2 ~ 4 · 첫 줄 「**왜」 · 굵게/칠하기 짝 · ASCII 빼기 없음 · 중1 · 중2 √ 없음 · 줄 260자 안
+--   자료 파일(w_<학기>.py)이 있는 학기는 줄이 자료와 같은지도
+with v(cid, lines) as (values
+    {vals}
+), got as (
+  select c.id as cid, c.unit_id as u, z.ord, z.b,
+         (select min(w.ord) from jsonb_array_elements(c.blocks) with ordinality w(b, ord) where w.b->>'type' in ('warning', 'check')) as stop
+  from concepts c, jsonb_array_elements(c.blocks) with ordinality z(b, ord)
+  where c.unit_id in ({pat}) and {MINE}
+), want as (select c.id as cid from concepts c where c.unit_id in ({pat}) and c.id not in ('h1-1-14', 'm2-2-12')
+    and not exists (select 1 from jsonb_array_elements(c.blocks) z(b) where z.b->>'label' = {q(LABEL)} and z.b->>'src' is null)),
+ln as (select got.cid, got.u, l.i, l.s from got, jsonb_array_elements_text(got.b->'lines') with ordinality l(s, i))
+select 'missing' as problem, want.cid, null::text as detail from want where not exists (select 1 from got where got.cid = want.cid)
+union all select 'twice', cid, count(*)::text from got group by cid having count(*) > 1
+union all select 'place', cid, ord || ' / ' || stop from got where stop is not null and ord <> stop - 1
+union all select 'shape', cid, b->>'id' from got where b->>'type' <> 'text' or b->>'id' !~ '^b\\d+$'
+union all select 'count', cid, jsonb_array_length(b->'lines')::text from got where jsonb_array_length(b->'lines') not between 2 and 4
+union all select 'first', cid, left(b->'lines'->>0, 20) from got where b->'lines'->>0 not like '**왜%'
+union all select 'bold', cid, i::text from ln where ((length(s) - length(replace(s, '**', ''))) / 2) % 2 = 1
+union all select 'hl', cid, i::text from ln where ((length(s) - length(replace(s, '==', ''))) / 2) % 2 = 1
+union all select 'minus', cid, i::text from ln where s ~ '(^|[[:space:](=,])-[0-9A-Za-z]' or s like '% - %'
+union all select 'root', cid, i::text from ln where u ~ '^m[12]-' and s like '%√%'
+union all select 'long', cid, i || ' · ' || length(s) from ln where length(s) > 260
+union all select 'lines', got.cid, null from got join v using (cid) where got.b->'lines' is distinct from v.lines
+union all select 'total', null, count(*)::text from got
+order by 1, 2;
+"""
+
+
+if __name__ == "__main__":
+    what = (sys.argv[1:] or ["check-data"])[0]
+    arg = sys.argv[2] if len(sys.argv) > 2 else None
+    units = scope(arg)
+    data = {u: load(u) for u in units}
+    bad = [p for u in units for p in problems(u, data[u])]
+    if what == "check-data":
+        n = sum(len(d) for d in data.values())
+        for u in units:
+            if data[u]: print(f"{u}: {len(data[u])}개념")
+        print(f"합계 {n}개념 · 문제 {len(bad)}")
+        for p in bad: print("  ", p)
+        sys.exit(1 if bad else 0)
+    if bad:
+        sys.exit("자료에 문제가 있다 — python3 whygen/sql.py check-data")
+    if what == "apply":
+        sys.stdout.write("\n".join(apply_sql(u, data[u]) for u in units if data[u]))
+    elif what == "rollback":
+        sys.stdout.write(rollback_sql(units))
+    elif what == "check":
+        sys.stdout.write(check_sql(units, data))
diff --git a/whygen/w_m1_1.py b/whygen/w_m1_1.py
new file mode 100644
index 0000000..1b008d5
--- /dev/null
+++ b/whygen/w_m1_1.py
@@ -0,0 +1,139 @@
+# 중1-1 「💡 왜 그럴까?」 — 개념마다 규칙 · 약속이 왜 그렇게 되는지(whygen/sql.py 가 DB 에 넣는다)
+WHY = {
+    "m1-1-01": [
+        "**왜 '합성'수라고 할까?** 12 = 3 × 4처럼 1보다 큰 두 수의 곱으로 **만들어지는(합성되는)** 수는 1과 자기 자신 말고도 약수(3, 4)가 생겨요. 소수는 이렇게 ==더 쪼갤 수 없는 수==라서 약수가 딱 2개예요.",
+        "**왜 1은 소수에서 뺄까?** 1을 소수로 치면 6 = 2 × 3 = 1 × 2 × 3 = 1 × 1 × 2 × 3 …처럼 같은 수를 소수의 곱으로 쓰는 방법이 끝없이 생겨요. ==곱으로 쓰는 방법이 하나뿐==이도록 1은 따로 두기로 약속했어요.",
+    ],
+    "m1-1-02": [
+        "**왜 지수가 1 늘면 2배가 될까?** 2⁵ = 2⁴ × 2 — 지수 하나 늘리는 건 ==밑을 한 번 더 곱하는 것==이라 2⁴의 값(16)에 2를 곱해 32. 지수는 '몇 번 곱했나'를 세는 계수기예요.",
+        "**왜 1은 아무리 거듭제곱해도 1일까?** 1⁵ = 1 × 1 × 1 × 1 × 1 — 1은 곱해도 값을 바꾸지 않는 수라서, 몇 번을 곱하든 처음 값 1 그대로예요.",
+    ],
+    "m1-1-03": [
+        "**왜 소수로만 나눌까?** 72를 4로 나누면 4 = 2 × 2가 아직 덜 쪼개진 채로 남아요. 소수는 더 쪼갤 수 없는 부품이라 ==소수로만 나누어야 끝까지 분해==돼요.",
+        "**순서를 바꿔 나눠도 같을까?** 72를 3부터 나눠도 3, 3, 2, 2, 2 — 모으면 언제나 2³ × 3². 어떤 순서로 쪼개도 ==부품 목록은 하나뿐==이라서, 약수 · 최대공약수를 구하는 기준으로 쓸 수 있어요.",
+    ],
+    "m1-1-04": [
+        "**왜 (2³의 약수) × (3의 약수)일까?** 24 = 2³ × 3을 나누어떨어지게 하려면 2는 ==0개 ~ 3개==, 3은 ==0개 ~ 1개==만 쓸 수 있어요. 더 쓰면 24에 없는 부품이 필요하니까요.",
+        "그래서 2를 몇 개 쓸지(4가지)와 3을 몇 개 쓸지(2가지)를 짝 지은 4 × 2 = 8개가 약수 전부 — 지수에 1을 더하는 건 **0개 쓰는 경우**까지 세기 때문이에요.",
+    ],
+    "m1-1-05": [
+        "**왜 작은 지수일까?** 24 = 2³ × 3을 나누려면 2를 3개까지, 36 = 2² × 3²을 나누려면 2를 2개까지만 쓸 수 있어요. 두 수를 ==동시에== 나누려면 둘 다 허락하는 만큼 — 2개, 즉 작은 지수예요.",
+        "**왜 공약수는 모두 최대공약수의 약수일까?** 공약수는 두 수에 공통으로 든 부품만으로 만든 수예요. 그 부품을 가장 많이 모은 것이 최대공약수이니, 다른 공약수는 모두 그 안에 든 부품 묶음 — G의 약수예요.",
+    ],
+    "m1-1-06": [
+        "**왜 큰 지수일까?** 24 = 2³ × 3의 배수가 되려면 2를 ==적어도 3개==, 36 = 2² × 3²의 배수가 되려면 2를 적어도 2개 가져야 해요. 둘 다 만족하려면 3개 — 큰 지수예요. 한쪽에만 있는 소인수도 빠지면 그 수의 배수가 못 되니 전부 곱해요.",
+        "**왜 공배수는 모두 최소공배수의 배수일까?** 공배수는 두 수의 부품을 모두 갖춘 수예요. 꼭 필요한 만큼만 갖춘 가장 작은 것이 L이고, 다른 공배수는 L에 부품을 더 붙인 ==L × (자연수)== 꼴이에요.",
+    ],
+    "m1-1-07": [
+        "**왜 '똑같이 나누어 주기'는 최대공약수일까?** 36개와 48개를 남김없이 똑같이 나누려면 사람 수가 36도, 48도 나누어떨어지게 해야 해요 — 그게 **공약수**의 뜻이고, '가능한 한 많은 사람'이니 가장 큰 공약수예요.",
+        "**왜 '다시 만나기'는 최소공배수일까?** 6분 버스는 6, 12, 18, 24, …분, 8분 버스는 8, 16, 24, …분에 출발해요. 두 목록에 함께 있는 시각이 **공배수**이고, '처음 다시' 만나는 건 그중 가장 작은 ==24분==이에요.",
+    ],
+    "m1-1-08": [
+        "**왜 L = G × a × b일까?** 공배수는 A의 부품(G, a)과 B의 부품(G, b)을 모두 가져야 해요. G는 둘이 함께 쓰는 몫이라 한 번이면 되고, a와 b는 서로소라 겹치는 부품이 없으니 ==둘 다 따로== 곱해야 가장 작은 공배수가 돼요.",
+        "**왜 세 수에서는 안 될까?** 2, 2, 2의 곱은 8이지만 최대공약수 × 최소공배수는 2 × 2 = 4예요. A × B에는 G가 **두 번** 들어 있어서 G × L과 맞아떨어지는데, 세 수의 곱에는 G가 세 번 들어 있으니까요.",
+    ],
+    "m1-1-09": [
+        "**왜 부호를 붙일까?** '5도'만 쓰면 영상인지 영하인지 알 수 없어요. 크기(5)와 방향(+ 또는 −)을 한 번에 담으려고 부호를 붙여요 — 그래서 ==부호와 크기가 함께 한 수==예요.",
+        "**왜 0은 양수도 음수도 아닐까?** 0은 방향을 재는 **기준 자리**예요. 오른쪽(+)으로도 왼쪽(−)으로도 가지 않은 곳이라 어느 쪽 이름도 붙지 않아요.",
+    ],
+    "m1-1-10": [
+        "**왜 '유리수'라고 할까?** 영어 rational number의 ratio(비)에서 온 이름 — 두 정수의 **비(나눗셈)** a/b로 나타낼 수 있는 수라는 뜻이에요. 그래서 3 = 3/1, 0.7 = 7/10도 모두 유리수예요.",
+        "**왜 분모에 0은 안 될까?** a/b는 a ÷ b예요. 6 ÷ 0 = □라면 □ × 0 = 6이어야 하는데 그런 수는 없어요. ==0으로 나누는 셈은 답이 없어서== 분모는 0이 아닌 정수로 약속해요.",
+    ],
+    "m1-1-11": [
+        "**왜 오른쪽으로 갈수록 클까?** 수직선은 0에서 오른쪽으로 한 칸 갈 때마다 1씩 **더하도록** 만든 줄이에요. 그래서 더 오른쪽 = 더 많이 더한 수, 왼쪽으로 한 칸은 1씩 빼는 것이라 −1, −2, −3, …으로 작아져요.",
+        "**왜 간격이 같아야 할까?** 칸이 고르지 않으면 같은 '1 차이'가 어디선 길고 어디선 짧아져요. 간격이 같아야 ==두 점 사이의 길이 = 두 수의 차==가 되어 길이로 수를 비교할 수 있어요.",
+    ],
+    "m1-1-12": [
+        "**왜 절댓값이 a인 수는 두 개일까?** 원점에서 오른쪽으로 a, 왼쪽으로 a — 같은 거리만큼 떨어진 곳이 ==양쪽에 하나씩== 있으니까요(a > 0). 0만은 원점 그 자리라 하나뿐이에요.",
+        "**왜 크기만 따로 볼까?** 빚 5만 원과 저금 5만 원은 방향이 반대지만 '액수'는 같아요. 방향은 부호가, 크기는 절댓값이 맡으면 다음에 배울 셈의 규칙(절댓값끼리 더하고 빼기)이 간단해져요.",
+    ],
+    "m1-1-13": [
+        "**왜 음수끼리는 절댓값이 클수록 작을까?** 절댓값이 크다 = 원점에서 멀다. 음수는 원점의 왼쪽에 있으니 멀수록 ==더 왼쪽==이고, 수직선에서는 왼쪽일수록 작은 수예요. −5는 −2보다 3칸 더 왼쪽이에요.",
+        "**왜 음수는 언제나 양수보다 작을까?** 음수는 모두 0의 왼쪽, 양수는 모두 0의 오른쪽 — 0을 사이에 두고 갈라져 있어서 절댓값이 얼마든 순서가 이미 정해져 있어요.",
+    ],
+    "m1-1-14": [
+        "**왜 '작지 않다'가 ≥일까?** 두 수 사이는 '작다 · 같다 · 크다' 셋 중 하나예요. '작다'를 빼면 남는 건 ==같거나 크다== — 그래서 ≥예요. '크지 않다'도 같은 까닭으로 ≤예요.",
+        "**왜 작은 수를 왼쪽에 둘까?** 수직선에서 작은 수가 왼쪽이라, −2 ≤ a < 3처럼 쓰면 식의 모양이 수직선 위 구간과 그대로 겹쳐서 한눈에 읽혀요.",
+    ],
+    "m1-1-15": [
+        "**왜 다른 부호끼리는 절댓값을 뺄까?** (+3) + (−7)은 3만 원 벌고 7만 원 쓴 것 — 번 3만 원과 쓴 3만 원이 서로 지워지고(+3과 −3이 만나 0) ==남은 4만 원이 쓴 쪽==이라 −4예요.",
+        "**왜 빼기는 부호를 바꿔 더하기일까?** 5 − 3과 5 + (−3)은 수직선에서 둘 다 '왼쪽으로 3칸'이에요. 그러니 (−2) − (−5)는 '왼쪽 5칸'을 거꾸로 — 오른쪽 5칸, 즉 +5를 더하기예요.",
+    ],
+    "m1-1-16": [
+        "**왜 (음수) × (음수)는 양수일까?** (−3) × 3 = −9, (−3) × 2 = −6, (−3) × 1 = −3, (−3) × 0 = 0 — 곱하는 수가 1 줄 때마다 답이 ==3씩 커져요==. 이 규칙을 그대로 이어 가면 (−3) × (−1) = 3, (−3) × (−2) = 6.",
+        "**왜 나눗셈의 부호도 같을까?** 나눗셈은 곱셈을 거꾸로 한 것 — (−24) ÷ 6 = □는 □ × 6 = −24인 수라서 −4예요. 곱셈의 부호 규칙이 그대로 따라와요.",
+    ],
+    "m1-1-17": [
+        "**왜 곱셈을 덧셈보다 먼저 할까?** 2 + 3 × 4에서 3 × 4는 4 + 4 + 4를 줄여 쓴 **한 덩어리**예요. 덩어리를 먼저 풀어야 2 + 12 = 14. 순서를 하나로 약속해야 ==누가 풀어도 같은 답==이 나와요.",
+        "**왜 곱셈 · 나눗셈은 왼쪽부터일까?** 8 ÷ 2 × 4에서 '÷ 2'는 2로만 나누라는 뜻이지 2 × 4로 나누라는 뜻이 아니에요. 앞에서부터 하면 ÷ 2는 2에만, × 4는 4에만 걸려서 식이 말한 그대로 16이 돼요.",
+    ],
+    "m1-1-18": [
+        "**왜 거리는 (큰 수) − (작은 수)일까?** −3부터 5까지는 −3 → 0으로 3칸, 0 → 5로 5칸, 모두 8칸이에요. 5 − (−3) = 5 + 3 = 8이 바로 ==이 두 토막을 더한 것==이에요.",
+        "**왜 한가운데는 합 ÷ 2일까?** 가운데 점은 A에서 거리의 절반만큼 간 곳: −3 + 8 ÷ 2 = 1. 두 수를 더해 2로 나누는 것도 '두 수를 똑같이 나눈 값'이라 같은 자리가 나와요.",
+    ],
+    "m1-1-19": [
+        "**왜 수를 문자 앞에 쓸까?** a3이라고 쓰면 a³(a의 세제곱)과 헷갈려요. 수를 앞에 두는 3a로 약속하면 ==3 곱하기 a==로만 읽혀요.",
+        "**왜 1a는 a로 쓸까?** 1을 곱해도 값이 그대로라 1은 아무 정보가 없어요. (−1) × a도 부호만 남겨 −a. 하지만 0.1a의 1은 '0.1'이라는 **수의 일부**라 지울 수 없어요.",
+    ],
+    "m1-1-20": [
+        "**왜 문자를 쓸까?** 연필이 800원이면 5자루는 4000원 — 그런데 값이 바뀔 때마다 다시 계산하는 대신 a원으로 두면 5a원 하나가 ==모든 경우를 한꺼번에== 말해 줘요.",
+        "**왜 두 자리 수는 10a + b일까?** 십의 자리 숫자 a는 '10이 a개', 일의 자리 숫자 b는 '1이 b개'라는 뜻이에요. 자릿값을 곱해 더해야 원래 수 — 37 = 10 × 3 + 7.",
+    ],
+    "m1-1-21": [
+        "**왜 음수는 괄호에 넣어 대입할까?** a²은 'a를 두 번 곱하기'라서 a 자리에 −3이 ==통째로== 들어가야 (−3) × (−3) = 9예요. 괄호 없이 −3²이라 쓰면 '3²에 − 붙이기'로 읽혀 −9가 돼요.",
+        "**왜 생략한 ×를 되살릴까?** 3a에 a = 2를 넣고 32라고 쓰면 '서른둘'이 돼 버려요. 3 × 2로 되살려야 6이에요.",
+    ],
+    "m1-1-22": [
+        "**왜 항에 부호까지 넣을까?** −3x + 8y − 5는 (−3x) + (8y) + (−5) — 빼기를 '음수 더하기'로 보면 모든 항이 ==더하기로 이어진 덩어리==예요. 그래서 항은 부호까지 붙은 덩어리예요.",
+        "**왜 '일차'일까?** 차수는 곱해진 문자의 개수예요. 2x는 x가 1번, x²은 x가 2번 곱해진 것 — 가장 많이 곱해진 문자가 1번뿐인 식이라서 일차식이에요.",
+    ],
+    "m1-1-23": [
+        "**왜 동류항끼리만 합칠까?** 5x − 2x는 'x 5개에서 2개 덜기' = (5 − 2)x = 3x예요. 하지만 2x + 3은 묶을 **같은 문자 덩어리**가 없어서 더 줄어들지 않아요.",
+        "**왜 괄호 앞 −는 부호를 전부 바꿀까?** −(3x − 1)은 (−1) × (3x − 1) — 분배법칙으로 −1을 ==모든 항에 곱하니== −3x + 1이에요.",
+    ],
+    "m1-1-24": [
+        "**왜 항등식은 언제나 참일까?** 2(x + 1) = 2x + 2는 좌변을 정리하면 우변과 ==똑같은 식==이 돼요. 같은 식에 같은 수를 넣으니 결과도 늘 같아요 — x가 무엇이든!",
+        "**왜 방정식은 참 · 거짓이 갈릴까?** 2x + 1 = 7은 좌변과 우변이 다른 식이라 두 식의 값이 **우연히 같아지는** x(= 3)에서만 참이에요. 그 x를 찾는 일이 '푸는 것'이에요.",
+    ],
+    "m1-1-25": [
+        "**왜 양변에 같은 수를 더해도 될까?** a = b는 '두 양이 같다'는 뜻 — 같은 것에 같은 것을 더하거나 빼도 여전히 같아요. 저울 양쪽에 ==같은 추==를 올려도 기울지 않는 것과 같아요.",
+        "**왜 0으로 나누면 안 될까?** 3 × 0 = 5 × 0(둘 다 0)은 참인데, 양변을 0으로 나누면 3 = 5 — 거짓이 돼요. 0으로 나누기는 다른 수를 같다고 만들어 버려서 금지예요.",
+    ],
+    "m1-1-26": [
+        "**왜 이항하면 부호가 바뀔까?** x + 3 = 8에서 3을 없애려고 양변에서 3을 빼면 x + 3 − 3 = 8 − 3. 좌변의 3은 사라지고 우변에 −3이 남으니, 겉으로는 ==+3이 넘어가며 −3==이 된 것처럼 보여요.",
+        "**왜 분모의 최소공배수를 곱할까?** 양변에 같은 수를 곱해도 등식은 그대로예요. 그러니 모든 분모가 나누어떨어지는 수(최소공배수)를 곱하면 분수가 **한 번에** 사라져요.",
+    ],
+    "m1-1-27": [
+        "**왜 가운데 수를 x로 둘까?** x − 1, x, x + 1로 두면 더할 때 −1과 +1이 지워져 ==3x만== 남아요. 첫 수를 x로 두면 x + (x + 1) + (x + 2) = 3x + 3 — 답은 같지만 한 단계가 늘어요.",
+        "**왜 나이 문제에서 모두 x살씩 늘까?** 시간은 누구에게나 똑같이 흘러서 x년 뒤엔 어머니도 아들도 x살 더 먹어요. 그래서 두 사람의 **나이 차(26살)는 언제나 그대로**예요.",
+    ],
+    "m1-1-28": [
+        "**왜 거리 = 속력 × 시간일까?** 시속 40 km는 '1시간에 40 km씩'이라는 뜻이에요. 2시간이면 40 km가 2번, 3시간이면 3번 — 그래서 거리는 ==속력에 시간을 곱한 것==이에요.",
+        "**왜 속력은 평균 내면 안 될까?** 시속 2 km로 6 km(3시간), 시속 3 km로 6 km(2시간)를 가면 12 km를 5시간에 간 것 — 평균 시속 2.4 km예요. 느린 구간에 시간을 더 썼기 때문에 (2 + 3) ÷ 2 = 2.5와 달라요.",
+    ],
+    "m1-1-29": [
+        "**왜 수가 두 개 필요할까?** 평면은 가로와 세로 두 방향으로 펼쳐져 있어요. 수 하나로는 한 줄 위의 위치만 정할 수 있어서, '가로로 얼마, 세로로 얼마' ==두 수의 짝==이 있어야 한 점이 정해져요.",
+        "**왜 순서를 정할까?** (2, 5)는 오른쪽 2 · 위 5, (5, 2)는 오른쪽 5 · 위 2 — 다른 자리예요. '앞은 가로(x), 뒤는 세로(y)'로 약속해야 같은 주소를 누구나 같은 점으로 읽어요.",
+    ],
+    "m1-1-30": [
+        "**왜 제2사분면은 (−, +)일까?** 원점의 왼쪽은 x가 음수, 위쪽은 y가 양수예요. 오른쪽 위(+, +)에서 시작해 ==반시계 방향==으로 돌면 왼쪽 위(−, +) → 왼쪽 아래(−, −) → 오른쪽 아래(+, −) 순서가 돼요.",
+        "**왜 축 위의 점은 사분면이 없을까?** 사분면은 두 축이 나눈 '방'의 안쪽이에요. (3, 0)은 x축이라는 벽 위에 있어서 어느 방에도 들어가지 않아요 — 부호를 정할 수 없는 0이 있으니까요.",
+    ],
+    "m1-1-31": [
+        "**왜 가파르면 빠를까?** 오른쪽으로 같은 1칸(예: 1분) 가는 동안 위로 더 많이 오르면, 같은 시간에 y가 더 많이 변한 거예요. 그래서 ==가파름 = 변화의 빠르기==예요.",
+        "**왜 수평이면 멈춘 걸까?** 시간(x)은 흘러가는데 y가 그대로라는 뜻이에요. 거리 그래프라면 간 거리가 늘지 않았으니 그동안 멈춰 쉰 거예요.",
+    ],
+    "m1-1-32": [
+        "**왜 원점을 지날까?** x = 0이면 y = a × 0 = 0 — 볼펜을 0자루 사면 0원이듯 정비례는 ==0에서 출발==해요.",
+        "**왜 직선일까?** x가 1 늘 때마다 y는 언제나 a씩 늘어요(볼펜 한 자루에 800원씩). 같은 걸음으로 오르는 점들은 **한 줄로 곧게** 놓여요.",
+    ],
+    "m1-1-33": [
+        "**왜 xy가 일정할까?** 케이크 12조각을 x명이 나누면 한 사람 몫은 y = 12/x — ==(사람 수) × (한 사람 몫) = 전체 12==는 변하지 않아요. 그래서 x가 2배면 y는 절반이에요.",
+        "**왜 축에 닿지 않을까?** x가 아무리 커져도 12/x는 0이 되지 않고(12를 나눈 몫은 0보다 커요), x = 0은 나눌 수 없어서 빠져요. 그래서 곡선은 축에 한없이 가까워지기만 해요.",
+    ],
+    "m1-1-34": [
+        "**왜 맞물린 톱니바퀴는 곱이 같을까?** 맞물린 두 바퀴는 같은 시간 동안 ==서로 같은 개수의 톱니==가 지나가요. 지나간 톱니 수 = (톱니 수) × (회전 수)이니, 두 바퀴의 이 곱이 같아요.",
+        "**왜 '~당'이 보이면 정비례일까?** '1분당 3 L'처럼 단위마다 같은 양이 쌓이면, 시간이 x배면 양도 x배 — y/x가 일정한 관계가 바로 정비례예요.",
+    ],
+}
