+def ellipse(P, a, b, at, c="sky", w=4.5, n=72):
+    pts = [P.P(a * math.cos(2 * math.pi * k / n), b * math.sin(2 * math.pi * k / n)) for k in range(n + 1)]
+    return P.f.poly(pts, at=at, c=c, w=w, z=False)
