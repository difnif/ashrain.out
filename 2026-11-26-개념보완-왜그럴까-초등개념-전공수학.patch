+# ── 넓이 모형 ────────────────────────────────────────────────────────────────
+def area_model(f, cols, rows, cells, x0=70, y0=110, W=520, H=480, at_cells=None, heads_at="q", cols_c=("teal", "gold", "coral", "sky")):
