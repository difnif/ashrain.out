+def tile(f, x, y, w, h, s, c, at, dl=0, un=None, z=26, fo=0.3):
+    """칸(가운데 x, y) + 글자 — 두 요소"""
+    r = f.rect(x - w / 2, y - h / 2, w, h, at=at, c=c, sw=3, rx=8, f=c, fo=fo, dl=dl, un=un)
+    t = f.text(x, y + z * 0.36, s, z=z, c=c, at=at, dl=dl + 40, un=un, b=800)
+    return [r, t]
