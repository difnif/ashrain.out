+def tree(f, levels, x0=60, x1=620, y0=90, dy=150, at_levels=None, z=30):
+    """가지 그림: levels = [[이름…], [이름…] …] — 아래 단은 위 단의 모든 가지에서 뻗는다. 단마다 at_levels[k] 에 그어진다"""
+    pos = [[((x0 + x1) / 2, y0 - 50)]]
+    cnt = 1
+    for k, names in enumerate(levels):
+        cnt *= len(names)
+        row = []
+        n = cnt
+        for i in range(n):
+            row.append((x0 + (x1 - x0) * (i + 0.5) / n, y0 + dy * k))
