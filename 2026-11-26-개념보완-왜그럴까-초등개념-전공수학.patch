+def table(f, heads, rows, x0=60, y0=110, cw=None, rh=70, at_rows=None, z=30, hl=None):
+    """표 — 머리 줄 + 줄마다 at_rows[i] 에 써진다(칸마다 조금씩 늦게)"""
