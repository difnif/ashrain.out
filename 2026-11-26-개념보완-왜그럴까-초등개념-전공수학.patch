+      }
+    }
+    assert.ok(cnt > 60, `그린 화면 ${cnt}`);
+    console.log(`   화면 ${cnt}개`);
+  });
+} finally {
+  fs.rmSync(tmp, { recursive: true, force: true });
+}
+
+console.log(`\n${n - failed}/${n} 통과`);
+if (failed) process.exit(1);
