+    w = max(z * 1.25, tw(s, z) + z * 0.6)
+    r = f.rect(x - w / 2, y - z * 0.98, w, z * 1.4, c=c, sw=3, rx=z * 0.42, f=c, fo=fo, at=at, dl=dl, un=un)
+    t = f.text(x, y, s, z=z, c=c, at=at, dl=dl + 60, un=un, b=800)
+    return [r, t]
