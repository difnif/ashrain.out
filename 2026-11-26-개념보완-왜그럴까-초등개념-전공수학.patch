+    rw += c.w * scale + 6; rh = Math.max(rh, c.h * scale);
+  }
+  html += `</div></div>`;
+  lineW += rw + 6; rowH = Math.max(rowH, rh + 24);
+  colI++;
+  if (colI >= cols) { W = Math.max(W, lineW); H += rowH; colI = 0; lineW = 0; rowH = 0; }
+}
+if (colI) { W = Math.max(W, lineW); H += rowH; }
