+def tw(s, z):
+    """무대 글자 폭 어림(draw.jsx 의 estimate 와 같은 계수) — {분자/분모} 는 위아래 중 넓은 쪽"""
+    s = str(s)
+    w = 0.0
+    i = 0
+    while i < len(s):
+        ch = s[i]
+        if ch == "{":
+            d, j = 0, i
+            while j < len(s):
+                if s[j] == "{":
+                    d += 1
+                elif s[j] == "}":
+                    d -= 1
+                    if d == 0:
+                        break
+                j += 1
+            inner = s[i + 1:j]
+            k = inner.find("/")
+            if k >= 0:
+                w += max(tw(inner[:k], z * 0.72), tw(inner[k + 1:], z * 0.72)) / z + 0.32
+            else:
+                w += tw(inner, z * 0.62) / z
+            i = j + 1
+            continue
+        if ch in "^_" and i + 1 < len(s) and s[i + 1] == "{":
+            j = s.index("}", i)
+            w += tw(s[i + 2:j], z * 0.62) / z
+            i = j + 1
+            continue
+        c = ord(ch)
+        if 0xAC00 <= c <= 0xD7A3:
+            w += 0.93
+        elif ch == " ":
+            w += 0.25
+        elif ch.isdigit():
+            w += 0.58
+        elif "a" <= ch <= "z":
+            w += 0.52
+        elif "A" <= ch <= "Z":
+            w += 0.66
+        elif ch in "²³°":
+            w += 0.38
+        elif ch in "()[],.:":
+            w += 0.32
+        elif ch in "×÷+−=<>≤≥":
+            w += 0.66
+        elif ch in "‹›`":
+            w += 0
+        else:
+            w += 0.7
+        i += 1
+    return w * z
+
