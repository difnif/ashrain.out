+def scr_ang(P, x0, y0, x1, y1):
+    """화면에서 (x0, y0) → (x1, y1) 방향의 각(도, 시계 반대 +)"""
+    X0, Y0 = P.P(x0, y0)
+    X1, Y1 = P.P(x1, y1)
+    return math.degrees(math.atan2(-(Y1 - Y0), X1 - X0))
+
