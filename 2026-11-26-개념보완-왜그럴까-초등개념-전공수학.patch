+
+test("카드 머리 · 칩: no 비움(번호 없이) · title(방침을 평문으로) · tab(예제 n) — 수식 꼴({a/b} · ^{} · _{} · √{}) 이 남지 않음", () => {
+  for (const { k, it } of ALL) {
